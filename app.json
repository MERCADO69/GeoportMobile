{
  "expo": {
    "name": "GeoportMalaybalay",
    "slug": "GeoportMalaybalay",
    "owner": "mart_dev",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "geoportmalaybalay",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.anonymous.GeoportMalaybalay",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "NOTIFICATIONS"
      ]
    },
    "ios": {
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow GeoportMalaybalay to access your camera",
        "NSMicrophoneUsageDescription": "Allow GeoportMalaybalay to access your microphone",
        "NSLocationWhenInUseUsageDescription": "GeoportMalaybalay uses your location to provide routing features",
        "NSUserTrackingUsageDescription": "GeoportMalaybalay uses tracking for app analytics and push notifications"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GeoportMalaybalay to access your camera",
          "microphonePermission": "Allow GeoportMalaybalay to access your microphone",
          "recordAudioAndroid": true
        }
      ],
      "expo-notifications",
      "expo-location",
      "expo-image-picker",

      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      "@config-plugins/react-native-webrtc"
    ],
    "extra": {
      "eas": {
        "projectId": "25d1864e-9bcb-4ae7-bc10-ec8ee8e25efb"
      }
    },
    "newArchEnabled": true
  }
}
